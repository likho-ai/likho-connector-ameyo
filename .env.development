# Committed: the local stack (likho-infra), no secrets. Your own values go in .env.development.local
# (ignored by git): LIKHO_API_KEY and WORKSPACE_ID (an API key made on the settings page), the
# dialer's address and credentials, and the queries. Read order: .env, .env.local,
# .env.development, .env.development.local; a real environment variable wins over all of them.

LIKHO_ENV=development
LOG_LEVEL=info
HTTP_PORT=4060

DATABASE_URL=postgres://likho_connector:likho_connector@localhost:5433/likho_connector
NATS_URL=nats://localhost:4222
CONSUMER_GROUP=likho-connector-ameyo
CONSUMERS_ENABLED=true

LIKHO_API_URL=http://localhost:8080
# LIKHO_API_KEY, WORKSPACE_ID: in .env.development.local
SOURCE=ameyo

# AMEYO_VOICELOG_URL, AMEYO_HASH_KEY, AMEYO_POLICY_NAME, AMEYO_REQUESTING_HOST: in .env.development.local
AMEYO_TIMEOUT_SECONDS=120

# DIALER_DATABASE_URL and the real queries (queries/*.local.sql): in .env.development.local
CALLS_QUERY_FILE=queries/calls.example.sql
CALL_QUERY_FILE=queries/call.example.sql

SCHEDULE_ENABLED=false
POLL_INTERVAL_SECONDS=300
BATCH_LIMIT=50
DAILY_LIMIT=200
SCHEDULE_START=
CAMPAIGNS=
MIN_TALK_SECONDS=20
PHONE_DIGITS=4

WRITEBACK_ENABLED=false
# CRM_DATABASE_URL and queries/writeback.local.sql: in .env.development.local
WRITEBACK_QUERY_FILE=queries/writeback.example.sql
