# Committed: no secrets here. Secrets for this environment live in .env.production.local (ignored by
# git; made by likho-infra/scripts/make-env-secrets.py, then filled in) or in Kubernetes Secrets
# (likho-deploy). Read order: .env, .env.local, .env.production, .env.production.local; a real
# environment variable wins.

LIKHO_ENV=production
LOG_LEVEL=info
HTTP_PORT=4060

# DATABASE_URL: in .env.production.local
NATS_URL=nats://nats:4222
CONSUMER_GROUP=likho-connector-ameyo
CONSUMERS_ENABLED=true

LIKHO_API_URL=http://likho-gateway
# LIKHO_API_KEY, WORKSPACE_ID: in .env.production.local
SOURCE=ameyo

# AMEYO_VOICELOG_URL, AMEYO_HASH_KEY, AMEYO_POLICY_NAME, AMEYO_REQUESTING_HOST: in .env.production.local
AMEYO_TIMEOUT_SECONDS=120

# DIALER_DATABASE_URL and the real queries: in .env.production.local (the files are mounted)
CALLS_QUERY_FILE=queries/calls.example.sql
CALL_QUERY_FILE=queries/call.example.sql

SCHEDULE_ENABLED=false
POLL_INTERVAL_SECONDS=300
BATCH_LIMIT=50
DAILY_LIMIT=200
SCHEDULE_START=
CAMPAIGNS=
MIN_TALK_SECONDS=20
PHONE_DIGITS=4

WRITEBACK_ENABLED=false
# CRM_DATABASE_URL and the write-back query: in .env.production.local
WRITEBACK_QUERY_FILE=queries/writeback.example.sql

# How long the start keeps trying to reach NATS before giving up.
NATS_CONNECT_TIMEOUT_SECONDS=120
# Metrics are always at GET /metrics. To also push them (OTLP/HTTP, e.g. the obs profile): http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
